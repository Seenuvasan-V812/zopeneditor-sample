 %PROCESS SOURCE RULES(LAXIF);
 TESTPSAM2: PROC OPTIONS(MAIN);
   DCL SYSPRINT FILE STREAM PRINT;
   DCL PSAM2 EXTERNAL ENTRY;
   %INCLUDE CUSTPLI;
   %INCLUDE BALSTATS;

   OPEN FILE (SYSPRINT);
   CALL TEST_FIRST_POSITIVE_BAL;
   CALL TEST_MULTI_RECORDS;
   CALL TEST_NEGATIVE_BAL;
   CLOSE FILE (SYSPRINT);
   RETURN;

   TEST_FIRST_POSITIVE_BAL: PROCEDURE;
     DCL TEST_PASSED BIT(1);

     CUSTFILE_RECORD = ' ';
     BALANCE_FIRST_TIME_SW = 1;
     CUSTOMER_RECORD.ACCT_BALANCE = 100.00;
     CALL PSAM2 (CUSTFILE_RECORD, CUSTOMER_BALANCE_STATS);

     TEST_PASSED = '1'B;
     IF (BALANCE_MIN ^= 100.00) THEN
       TEST_PASSED = '0'B;
     IF TEST_PASSED THEN
       PUT FILE (SYSPRINT) SKIP(1)
         LIST ('TEST_FIRST_POSITIVE_BAL: PASS');
     ELSE
       PUT FILE (SYSPRINT) SKIP(1)
         LIST ('TEST_FIRST_POSITIVE_BAL: FAIL');
   END TEST_FIRST_POSITIVE_BAL;

   TEST_MULTI_RECORDS: PROCEDURE;
     DCL TEST_PASSED BIT(1);

     CUSTFILE_RECORD = ' ';
     BALANCE_FIRST_TIME_SW = 1;
     CUSTOMER_RECORD.ACCT_BALANCE = 100.00;
     CALL PSAM2 (CUSTFILE_RECORD, CUSTOMER_BALANCE_STATS);
     CUSTOMER_RECORD.ACCT_BALANCE = 500.00;
     CALL PSAM2 (CUSTFILE_RECORD, CUSTOMER_BALANCE_STATS);
     CUSTOMER_RECORD.ACCT_BALANCE = 300.00;
     CALL PSAM2 (CUSTFILE_RECORD, CUSTOMER_BALANCE_STATS);

     TEST_PASSED = '1'B;
     IF (BALANCE_COUNT ^= 3) THEN TEST_PASSED = '0'B;
     IF (BALANCE_TOTAL ^= 900.00) THEN TEST_PASSED = '0'B;
     IF (BALANCE_MIN ^= 100.00) THEN TEST_PASSED = '0'B;
     IF (BALANCE_MAX ^= 500.00) THEN TEST_PASSED = '0'B;
     IF (BALANCE_AVG ^= 300.00) THEN TEST_PASSED = '0'B;
     IF TEST_PASSED THEN
       PUT FILE (SYSPRINT) SKIP(1)
         LIST ('TEST_MULTI_RECORDS: PASS');
     ELSE
       PUT FILE (SYSPRINT) SKIP(1)
         LIST ('TEST_MULTI_RECORDS: FAIL');
   END TEST_MULTI_RECORDS;

   TEST_NEGATIVE_BAL: PROCEDURE;
     DCL TEST_PASSED BIT(1);

     CUSTFILE_RECORD = ' ';
     BALANCE_FIRST_TIME_SW = 1;
     CUSTOMER_RECORD.ACCT_BALANCE = 100.00;
     CALL PSAM2 (CUSTFILE_RECORD, CUSTOMER_BALANCE_STATS);
     CUSTOMER_RECORD.ACCT_BALANCE = -50.00;
     CALL PSAM2 (CUSTFILE_RECORD, CUSTOMER_BALANCE_STATS);

     TEST_PASSED = '1'B;
     IF (BALANCE_MIN ^= -50.00) THEN TEST_PASSED = '0'B;
     IF TEST_PASSED THEN
       PUT FILE (SYSPRINT) SKIP(1)
         LIST ('TEST_NEGATIVE_BAL: PASS');
     ELSE
       PUT FILE (SYSPRINT) SKIP(1)
         LIST ('TEST_NEGATIVE_BAL: FAIL');
   END TEST_NEGATIVE_BAL;

 END TESTPSAM2;